[Unit]
Description=NAS-Stack (podman compose)
After=network-online.target podman.socket
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# conmon'ы контейнеров — потомки этого юнита; при KillMode=control-group
# systemd убивал их при остановке, оставляя контейнеры "Up" без init-процесса.
KillMode=process
WorkingDirectory=%h/projects/nas-stack
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/lib/docker/cli-plugins
ExecStart=/usr/bin/bash %h/projects/nas-stack/scripts/start-stack.sh
ExecStop=/usr/bin/podman compose down
# На старте скрипт ждёт NAS и health-check'и; 300s мало для холодной загрузки.
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=default.target
