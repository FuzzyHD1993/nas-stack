diff --git a/application/archive.php b/application/archive.php
new file mode 100644
index 0000000..8a187f3
--- /dev/null
+++ b/application/archive.php
@@ -0,0 +1,19 @@
+<?php
+// Универсальное чтение файла из .zip и .7z (FLibrary-дистрибутив).
+function archive_extract($archive, $entry) {
+    if (!$archive || !is_file($archive)) return false;
+    $ext = strtolower(pathinfo($archive, PATHINFO_EXTENSION));
+    if ($ext === 'zip') {
+        $zip = new ZipArchive();
+        if ($zip->open($archive) !== true) return false;
+        $data = $zip->getFromName($entry);
+        $zip->close();
+        return $data;
+    }
+    if ($ext === '7z') {
+        $cmd = '7z e -so ' . escapeshellarg($archive) . ' ' . escapeshellarg($entry) . ' 2>/dev/null';
+        $data = shell_exec($cmd);
+        return ($data === null || $data === '') ? false : $data;
+    }
+    return false;
+}
