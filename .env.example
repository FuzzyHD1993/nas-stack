# ============================================================
# NAS-Stack — переменные окружения
# ============================================================
# cp .env.example .env   и заполните обязательные поля (помечены *).
# Значения ниже — разумные дефолты, стек запускается «из коробки»
# после заполнения секретов.
# ============================================================

# ---------- Пути к хранилищу ----------
# Корень монтирования NAS (или локальной папки с данными)
NAS_ROOT=/mnt/nas
# Корень медиатеки внутри NAS (фильмы/сериалы/музыка/фото)
LIBRARY_ROOT=/mnt/nas/root/FuzzyHD
# Производные хосты-пути (можно переопределить каждым отдельно)
BACKUP_HOST_DIR=${NAS_ROOT}/Backups
BOOKS_HOST_DIR=${NAS_ROOT}/Books
YOUTUBE_HOST_DIR=${NAS_ROOT}/YT_video
MEDIA_MOVIES_HOST_DIR=${LIBRARY_ROOT}/Movies
MEDIA_TV_HOST_DIR=${LIBRARY_ROOT}/TV
MEDIA_PHOTOS_HOST_DIR=${LIBRARY_ROOT}/Photos
MUSIC_HOST_DIR=${LIBRARY_ROOT}/Music

# ---------- Сеть ----------
# LAN-IP хоста (доступный браузеру/NAS)
HOST_IP=192.168.0.4
# NAS (Synology/QNAP) *
NAS_HOST=192.168.0.5
NAS_USER=
NAS_PASS=
# accept-new — TOFU при первом подключении; yes — только с заранее
# залитым known_hosts в volume scheduler_ssh.
NAS_STRICT_HOST_KEY=accept-new
NAS_KNOWN_HOSTS=/root/.ssh/known_hosts
# Внутренние адреса (менять только при нестандартной схеме)
REDIS_ADDR=redis:6379
POSTGRES_URL=postgres://nas:nas_secret@postgres:5432/nas_history?sslmode=disable
POSTGRES_USER=nas
POSTGRES_PASSWORD=nas_secret
POSTGRES_DB=nas_history

# ---------- Авторизация ----------
# JWT_SECRET: сгенерируйте `openssl rand -hex 32`.
# При AUTH_ENABLED=true сервис НЕ стартует с пустым/дефолтным/коротким секретом.
JWT_SECRET=
# AUTH_PASSWORD обязателен при AUTH_ENABLED=true (минимум 8 символов, "admin" запрещён).
# При AUTH_ENABLED=false /login отключён, профили открыты.
AUTH_PASSWORD=
AUTH_ENABLED=false
# Время жизни JWT (например 168h). По умолчанию 7 дней.
AUTH_TOKEN_TTL=168h
# pprof выключен по умолчанию и слушает только loopback (PPROF_ADDR).
PPROF_ENABLED=false
# Секрет gateway -> notify-service (заголовок X-Gateway-Token).
# Без него /notify/update/run, /notify/update/rollback, /notify/env (POST)
# и /notify/env/reload отдают 403. Сгенерировать: openssl rand -hex 32
NOTIFY_GATEWAY_TOKEN=

# Отдельный секрет gateway -> history-service. Пусто = используется
# NOTIFY_GATEWAY_TOKEN (fallback), чтобы раскатка не требовала новой переменной.
# Если оба пусты, history-service отдаёт 503 на все ручки кроме /health.
HISTORY_GATEWAY_TOKEN=

# Токен админ-операций на хосте (Authorization: Bearer <ADMIN_TOKEN>).
# Закрывает host-exec: /notify/update/*, /notify/env*, /scheduler/update/run,
# а также host-agent /update/run, /cleanup/run, /duplicates/resolve.
# Без него gateway/scheduler НЕ СТАРТУЮТ (fail-closed), а host-agent
# отдаёт 403 на этих ручках. UI спросит его один раз и запомнит
# в localStorage (ключ admin_token). Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=

# Адреса прослушивания нативного host-agent (через запятую).
# По умолчанию только loopback. Второй адрес нужен контейнерам стека:
# scheduler/stats/media ходят на http://host.containers.internal:9998,
# а он резолвится НЕ в loopback, а в адрес хоста (в podman — 169.254.x
# через pasta/slirp, туда достучивается только интерфейс LAN).
#   127.0.0.1:9998,192.168.0.4:9998   <- LAN-IP хоста
# Даже при 0.0.0.0:9998 host-exec ручки закрыты ADMIN_TOKEN.
HOST_AGENT_BIND=127.0.0.1:9998,192.168.0.4:9998

# ---------- TMDb (медиатека) * ----------
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_LANG=ru-RU
# Фиксированные IP для обхода DNS (опционально)
TMDB_API_IP=143.204.238.23
TMDB_IMG_IP=185.59.220.199

# ---------- Prowlarr (поиск торрентов) ----------
PROWLARR_URL=
PROWLARR_API_KEY=
# Базовый URL прокси скачивания (обычно gateway); пусто = дефолт в compose.
DOWNLOAD_BASE_URL=http://host.containers.internal:8080
FLARESOLVERR_TIMEOUT=120000

# ---------- Торренты ----------
TORRENT_DESTINATION=homes/FuzzyHD/Music
TORRENT_DESTINATIONS=homes/FuzzyHD/Music,homes/FuzzyHD/Movies,homes/FuzzyHD/TV,homes/FuzzyHD/Games,homes/FuzzyHD/Books,homes/FuzzyHD/Courses
# Необязательные переопределения категорий:
# TORRENT_DESTINATION_MUSIC=homes/user/Music
# TORRENT_DESTINATION_MOVIES=homes/user/Movies

# ---------- RuTracker (авто-логин / cookie-fallback) ----------
RUTRACKER_USER=
RUTRACKER_PASS=
RUTRACKER_USER_ID=
RUTRACKER_COOKIE=

# ---------- Музыка (MPD) ----------
MPD_ADDR=host.containers.internal:6600
# Индикатор bit-perfect (выключите при использовании EasyEffects/EQ)
BIT_PERFECT_ENABLED=false
# OOM-check: глубина просмотра kernel-лога (мин)
OOM_CHECK_MINUTES=20

# ---------- Книги (Флибуста) ----------
FLIBUSTA_URL=https://flibusta.is
FLIBUSTA_MIRRORS=https://flibusta.is,https://flibusta.net,https://flibusta.lib
FLIBUSTA_LOCAL_URL=
# Локальное зеркало (профиль flibusta-local)
FLIBUSTA_DATA_DIR=/mnt/nas/root/FuzzyHD/flibusta-data
FLIBUSTA_ARCHIVES_DIR=/mnt/nas/root/FuzzyHD/Books/fb2.flibusta.lib.rus.ec.7z
FLIBUSTA_SRC_DIR=../flibusta-mirror
FLIBUSTA_DB_PASSWORD=change-me
HTTP_PROXY=

# ---------- YouTube ----------
# Провайдер POT (bgutil-pot), на хосте
POT_PROVIDER_URL=http://host.containers.internal:4416

# ---------- Медиа (транскод) ----------
MEDIA_WATCH_ENABLED=true
MEDIA_WATCH_DEBOUNCE_SEC=3
MEDIA_WATCH_POLL_SEC=20
TRANSCODE_VIDEO_ENABLED=true
TRANSCODE_ENCODER=auto
TRANSCODE_PRESET=veryfast
TRANSCODE_CRF=23

# ---------- Хост-агент (датчики/SMART/очистка/дубликаты) ----------
HOST_AGENT_URL=http://host.containers.internal:9998
# Публичный адрес books-opener для браузера (открытие файлов/VLC)
BOOKS_OPENER_PUBLIC_URL=http://localhost:9999
# Токен books-opener для сервис-сервис вызовов (media-service → opener).
# Браузер токен не знает; если задан — задайте его же media-service.
OPENER_TOKEN=
# Origin'ы дашборда, которым разрешено дёргать opener (CORS allowlist)
OPENER_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# ---------- Диск-watchdog ----------
DISK_WATCH_INTERVAL_MIN=30
DISK_WARN_PERCENT=80
DISK_CRIT_PERCENT=90

# ---------- ntfy (push на телефон) ----------
NTFY_URL=http://192.168.0.4:2586
NTFY_TOPIC=nas-alerts
NTFY_TOKEN=

# ---------- Прочее ----------
# Часовой пояс контейнеров
TZ=Asia/Novosibirsk
# Сколько бэкапов БД хранить
BACKUP_KEEP=7
